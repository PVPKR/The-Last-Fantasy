  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "1. \uD654\uBA74\uC744 \uB20C\uB7EC \uC870\uC774\uC2A4\uD2F1\uC744 \uC774\uC6A9\uD574
    \uC6C0\uC9C1\uC774\uC138\uC694.\n\n2. \uBAAC\uC2A4\uD130\uC5D0 \uC77C\uC815 \uAC70\uB9AC
    \uC811\uADFC \uC2DC, \uD50C\uB808\uC774\uC5B4\uB294 \uC790\uB3D9\uC73C\uB85C
    \uACF5\uACA9 \uD569\uB2C8\uB2E4.\n\n3.  \uBAAC\uC2A4\uD130 \uCC98\uCE58 \uC2DC,
    \uCF54\uC778\uC744 \uD68D\uB4DD\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\n4. 
    \uCF54\uC778\uC744 \uC18C\uBAA8\uD558\uC5EC, \uCCB4\uB825\uACFC \uACF5\uACA9\uB825\uC744
    \uC5C5\uADF8\uB808\uC774\uB4DC\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \n\n5.
    \uB9F5\uC5D0 Healing Zone\uC774 \uC788\uC2B5\uB2C8\uB2E4. \uB5A8\uC5B4\uC9C4
    \uCCB4\uB825\uC744 \uD68C\uBCF5\uD558\uC138\uC694.\n\n6.  \uBA38\uC26C\uB8F8\uC744
    \uCC98\uCE58\uD558\uC5EC \uCF54\uC778\uC744 \uD68D\uB4DD \uD6C4, \uC5C5\uADF8\uB808\uC774\uB4DC\uB97C
    \uD558\uC5EC\uC11C \uCD5C\uC885 \uBCF4\uC2A4\uB97C \uCC98\uCE58\uD558\uC138\uC694."
  m_isRightToLeft: 0
